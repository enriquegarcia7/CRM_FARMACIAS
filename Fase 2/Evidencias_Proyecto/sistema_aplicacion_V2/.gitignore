# ===================================
# SMARTPHARM CRM - .gitignore
# ===================================

# Variables de entorno y secretos
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ===================================
# BACKEND DJANGO
# ===================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
ENV/
env/
.venv

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles
/static_root

# Migrations (comentar si quieres versionar migraciones)
# */migrations/*.py
# !*/migrations/__init__.py

# Celery
celerybeat-schedule
celerybeat.pid

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# ===================================
# FRONTEND REACT
# ===================================

# Dependencies
node_modules/
/.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing
/coverage
*.coverage
.nyc_output

# Production
/build
/dist

# Vite
.vite/
vite.config.js.timestamp-*

# Misc
.DS_Store
*.swp
*.swo
*~
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===================================
# DOCKER
# ===================================

# Docker volumes
postgres_data/
static_volume/

# Docker Compose overrides
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml

# ===================================
# DATABASE
# ===================================

*.sql
*.dump
*.backup
*.db
*.sqlite
*.sqlite3
!Base_Datos/*.sql

# ===================================
# SISTEMA OPERATIVO
# ===================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ===================================
# OTROS
# ===================================

# Backups
*.bak
*.backup
*.old
*.orig
*.tmp

# Archivos de prueba
test_*.py
*_test.py
*.test.js
*.spec.js

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# Documentación generada
docs/_build/
site/

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
