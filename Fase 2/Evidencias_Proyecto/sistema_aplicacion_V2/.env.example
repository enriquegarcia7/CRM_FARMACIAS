DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Superusuario Django (creado automáticamente en el primer deploy)
DJANGO_SUPERUSER_USERNAME=bhartal
DJANGO_SUPERUSER_EMAIL=bastianhartal@gmail.com
DJANGO_SUPERUSER_PASSWORD=123456

# Frontend API URL
VITE_API_URL=http://localhost:8000

# Puertos de los servicios
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
